#: includes/Config.php:490
msgid "Post and page threshold for the small content-analysis batch"
msgstr ""

#: includes/Config.php:491
msgid "Websites at or below this combined number of posts and pages initially enter the small shared batch."
msgstr ""

#: includes/Config.php:499
msgid "Post and page threshold for the medium content-analysis batch"
msgstr ""

#: includes/Config.php:500
msgid "Websites above the small threshold and at or below this combined number of posts and pages initially enter the medium shared batch. Larger websites enter the large batch."
msgstr ""

#: includes/Config.php:508
msgid "Post and page threshold for the large content-analysis batch"
msgstr ""

#: includes/Config.php:509
msgid "Websites above the medium threshold and at or below this combined number of posts and pages initially enter the large shared batch. Larger websites use an individual schedule."
msgstr ""

#: includes/Config.php:517
msgid "Active runtime threshold for the small content-analysis batch in seconds"
msgstr ""

#: includes/Config.php:518
msgid "After a successful run, a website above this active runtime is assigned at least to the medium batch."
msgstr ""

#: includes/Config.php:526
msgid "Active runtime threshold for the medium content-analysis batch in seconds"
msgstr ""

#: includes/Config.php:527
msgid "After a successful run, a website above this active runtime is assigned to the large batch."
msgstr ""

#: includes/Config.php:535
msgid "Active runtime threshold for the large content-analysis batch in seconds"
msgstr ""

#: includes/Config.php:536
msgid "After a successful run, a website above this active runtime is assigned to an individual schedule."
msgstr ""

#: includes/Config.php:544
msgid "Search plugin sources for shortcode and block registrations"
msgstr ""

#: includes/Config.php:545
msgid "Disabled by default: the analysis searches posts and pages only. When enabled, active plugin sources are indexed centrally and reused across websites to identify registrations that are not loaded in the current process."
msgstr ""

#: includes/Config.php:551
msgid "Show analysis request notice to local administrators"
msgstr ""

#: includes/Config.php:552
msgid "When a website has neither a saved result nor a planned storage or shortcode-and-block analysis, show local administrators a request notice under Tools. When disabled, the relevant Tools page is hidden instead."
msgstr ""

#: includes/Config.php:558
msgid "Maximum active runtime for small storage-analysis batches in minutes"
msgstr ""

#: includes/Config.php:559
msgid "Limits active processing time across short scheduled steps for each individual website in the small batch, not for the entire batch. Waiting for Cron or analysis capacity does not count."
msgstr ""

#: includes/Config.php:567
msgid "Maximum active runtime for medium storage-analysis batches in minutes"
msgstr ""

#: includes/Config.php:568
msgid "Limits active processing time across short scheduled steps for each individual website in the medium batch, not for the entire batch. Waiting for Cron or analysis capacity does not count."
msgstr ""

#: includes/Config.php:576
msgid "Maximum active runtime for individual storage analyses in minutes"
msgstr ""

#: includes/Config.php:577
msgid "Limits active processing time across short scheduled steps for individual websites. Waiting for Cron or analysis capacity does not count. Values up to twelve hours are allowed."
msgstr ""

#: includes/Config.php:585
msgid "Maximum active runtime for large storage-analysis batches in minutes"
msgstr ""

#: includes/Config.php:586
msgid "Limits active processing time across short scheduled steps for each individual website in the large batch. Waiting for Cron does not count."
msgstr ""

#: includes/Config.php:594
msgid "Maximum number of files for the orphan check"
msgstr ""

#: includes/Config.php:595
msgid "Only the largest potentially orphaned files up to this limit are checked for references in post and page content. The total number of detected files remains visible."
msgstr ""

#: includes/Config.php:603
msgid "Maximum shortcode and block analysis runtime in minutes"
msgstr ""

#: includes/Config.php:604
msgid "This limit applies to active PHP processing across resumable shortcode and block analysis steps. Waiting for the next Cron request does not count."
msgstr ""

#: includes/Config.php:612
msgid "Maximum input size per post content or metadata value (KiB)"
msgstr ""

#: includes/Config.php:613
msgid "This limit applies separately to each post or page content field and to each individual post-meta value. It is not a cumulative limit for an entire website analysis."
msgstr ""

#: includes/Config.php:621
msgid "Availability check cycle"
msgstr ""

#: includes/Config.php:622
msgid "How often the centrally scheduled availability check starts. Internal batch continuations are not affected."
msgstr ""

#: includes/Config.php:629
msgid "Websites per availability-check batch"
msgstr ""

#: includes/Config.php:630
msgid "Number of websites checked in one availability-monitoring Cron request. The default of 10 keeps failed DNS or HTTP requests within the request budget; larger values can speed up healthy networks but may require more continuations when websites time out."
msgstr ""

