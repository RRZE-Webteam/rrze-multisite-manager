#: includes/Config.php:360
msgid "Media threshold for small storage-analysis batches"
msgstr ""

#: includes/Config.php:361
msgid "Websites at or below this number of media attachments are assigned to the small shared batch, unless their last successful active runtime exceeds its threshold."
msgstr ""

#: includes/Config.php:369
msgid "Media threshold for medium storage-analysis batches"
msgstr ""

#: includes/Config.php:370
msgid "Websites above the small-batch threshold and at or below this value are assigned to the medium shared batch, unless their last successful active runtime exceeds its threshold."
msgstr ""

#: includes/Config.php:378
msgid "Media threshold for large storage-analysis batches"
msgstr ""

#: includes/Config.php:379
msgid "Websites above the medium-batch threshold and at or below this value are assigned to the large shared batch, unless their last successful active runtime exceeds its threshold."
msgstr ""

#: includes/Config.php:387
msgid "Active runtime threshold for small storage-analysis batches in seconds"
msgstr ""

#: includes/Config.php:388
msgid "A website above this active runtime is moved from the small to the medium shared batch after a successful complete run."
msgstr ""

#: includes/Config.php:396
msgid "Active runtime threshold for medium storage-analysis batches in seconds"
msgstr ""

#: includes/Config.php:397
msgid "A website above this active runtime is moved from the medium shared batch to an individual task after a successful complete run."
msgstr ""

#: includes/Config.php:405
msgid "Active runtime threshold for large storage-analysis batches in seconds"
msgstr ""

#: includes/Config.php:406
msgid "A website above this active runtime is moved from the large shared batch to an individual task after a successful complete run."
msgstr ""

#: includes/Config.php:414
msgid "Media attachments per index step in medium storage analyses"
msgstr ""

#: includes/Config.php:415
msgid "Allowed values: 10 to 300. The default of 150 reduces Cron continuations where processing remains fast."
msgstr ""

#: includes/Config.php:423
msgid "Index segments written per step in medium storage analyses"
msgstr ""

#: includes/Config.php:424
msgid "Allowed values: 8 to 192. The default of 96 reduces Cron continuations where database writes remain fast."
msgstr ""

#: includes/Config.php:432
msgid "Media attachments per index step in shared storage analyses"
msgstr ""

#: includes/Config.php:433
msgid "Allowed values: 5 to 150. The default of 75 reduces Cron continuations for small shared batches."
msgstr ""

#: includes/Config.php:441
msgid "Index segments written per step in shared storage analyses"
msgstr ""

#: includes/Config.php:442
msgid "Allowed values: 4 to 128. The default of 64 reduces Cron continuations for small shared batches."
msgstr ""

#: includes/Config.php:450
msgid "Media attachments per index step in individual storage analyses"
msgstr ""

#: includes/Config.php:451
msgid "Allowed values: 25 to 1000. The default of 500 reduces Cron continuations for individual tasks."
msgstr ""

#: includes/Config.php:459
msgid "Media attachments per index step in large storage analyses"
msgstr ""

#: includes/Config.php:460
msgid "Allowed values: 25 to 600. The default of 300 reduces Cron continuations for large shared batches."
msgstr ""

#: includes/Config.php:468
msgid "Index segments written per step in large storage analyses"
msgstr ""

#: includes/Config.php:469
msgid "Allowed values: 8 to 256. The default of 128 reduces continuation requests for large shared batches."
msgstr ""

#: includes/Config.php:477
msgid "Index segments written per step in individual storage analyses"
msgstr ""

#: includes/Config.php:478
msgid "Allowed values: 8 to 256. The default of 128 reduces Cron continuations for individual tasks."
msgstr ""

#: includes/Config.php:486
msgid "Maximum concurrent background processes"
msgstr ""

#: includes/Config.php:487
msgid "Shared network-wide limit for storage analyses, shortcode and block analyses, plugin and theme usage collection and dashboard metrics. Availability checks are not counted. Each process uses one PHP worker and one database connection. Default: 3. Allowed values: 1 to 16. Waiting tasks resume automatically."
msgstr ""

#: includes/Config.php:495
msgid "Maximum concurrent storage analyses per task type"
msgstr ""

#: includes/Config.php:496
msgid "Per-type limit for individual storage analyses and temporary indexes. The shared background process limit also applies. Small, medium and large shared batches each process one website at a time."
msgstr ""

#: includes/Config.php:504
msgid "Small shortcode and block analysis batch cycle"
msgstr ""

#: includes/Config.php:505
msgid "How often the central batch for small content inventories is run."
msgstr ""

#: includes/Config.php:512
msgid "Medium shortcode and block analysis batch cycle"
msgstr ""

#: includes/Config.php:513
msgid "How often the central batch for medium content inventories is run."
msgstr ""

#: includes/Config.php:520
msgid "Large shortcode and block analysis batch cycle"
msgstr ""

#: includes/Config.php:521
msgid "How often the central batch for large content inventories is run."
msgstr ""

#: includes/Config.php:528
msgid "Individual shortcode and block analysis cycle"
msgstr ""

#: includes/Config.php:529
msgid "How often individually scheduled shortcode and block analyses are run."
msgstr ""

#: includes/Config.php:536
msgid "Post and page threshold for the small content-analysis batch"
msgstr ""

#: includes/Config.php:537
msgid "Websites at or below this combined number of posts and pages initially enter the small shared batch."
msgstr ""

#: includes/Config.php:545
msgid "Post and page threshold for the medium content-analysis batch"
msgstr ""

#: includes/Config.php:546
msgid "Websites above the small threshold and at or below this combined number of posts and pages initially enter the medium shared batch. Larger websites enter the large batch."
msgstr ""

#: includes/Config.php:554
msgid "Post and page threshold for the large content-analysis batch"
msgstr ""

#: includes/Config.php:555
msgid "Websites above the medium threshold and at or below this combined number of posts and pages initially enter the large shared batch. Larger websites use an individual schedule."
msgstr ""

#: includes/Config.php:563
msgid "Active runtime threshold for the small content-analysis batch in seconds"
msgstr ""

#: includes/Config.php:564
msgid "After a successful run, a website above this active runtime is assigned at least to the medium batch."
msgstr ""

#: includes/Config.php:572
msgid "Active runtime threshold for the medium content-analysis batch in seconds"
msgstr ""

#: includes/Config.php:573
msgid "After a successful run, a website above this active runtime is assigned to the large batch."
msgstr ""

#: includes/Config.php:581
msgid "Active runtime threshold for the large content-analysis batch in seconds"
msgstr ""

#: includes/Config.php:582
msgid "After a successful run, a website above this active runtime is assigned to an individual schedule."
msgstr ""

#: includes/Config.php:590
msgid "Show analysis request notice to local administrators"
msgstr ""

#: includes/Config.php:591
msgid "When a website has neither a saved result nor a planned storage or shortcode-and-block analysis, show local administrators a request notice under Tools. When disabled, the relevant Tools page is hidden instead."
msgstr ""

#: includes/Config.php:597
msgid "Maximum active runtime for small storage-analysis batches in minutes"
msgstr ""

#: includes/Config.php:598
msgid "Limits active processing time across short scheduled steps for each individual website in the small batch, not for the entire batch. Waiting for Cron or analysis capacity does not count."
msgstr ""

#: includes/Config.php:606
msgid "Maximum active runtime for medium storage-analysis batches in minutes"
msgstr ""

#: includes/Config.php:607
msgid "Limits active processing time across short scheduled steps for each individual website in the medium batch, not for the entire batch. Waiting for Cron or analysis capacity does not count."
msgstr ""

#: includes/Config.php:615
msgid "Maximum active runtime for individual storage analyses in minutes"
msgstr ""

#: includes/Config.php:616
msgid "Limits active processing time across short scheduled steps for individual websites. Waiting for Cron or analysis capacity does not count. Values up to twelve hours are allowed."
msgstr ""

#: includes/Config.php:624
msgid "Maximum active runtime for large storage-analysis batches in minutes"
msgstr ""

#: includes/Config.php:625
msgid "Limits active processing time across short scheduled steps for each individual website in the large batch. Waiting for Cron does not count."
msgstr ""

#: includes/Config.php:633
msgid "Maximum number of files for the orphan check"
msgstr ""

#: includes/Config.php:634
msgid "Only the largest potentially orphaned files up to this limit are checked for references in post and page content. The total number of detected files remains visible."
msgstr ""

#: includes/Config.php:642
msgid "Maximum shortcode and block analysis runtime in minutes"
msgstr ""

#: includes/Config.php:643
msgid "This limit applies to active PHP processing across resumable shortcode and block analysis steps. Waiting for the next Cron request does not count."
msgstr ""

#: includes/Config.php:651
msgid "Maximum input size per post content (KiB)"
msgstr ""

#: includes/Config.php:652
msgid "This limit applies separately to the content of each post or page. It is not a cumulative limit for an entire website analysis."
msgstr ""

#: includes/Config.php:660
msgid "Maximum stored findings per website and type"
msgstr ""

#: includes/Config.php:661
msgid "Cumulative limit for one website analysis, applied separately to shortcodes and blocks. A shortcode finding is one occurrence; a block finding is one block type in one post, regardless of how often it occurs there. Further findings are counted but not stored. Default: 1000. Allowed values: 100 to 5000."
msgstr ""

#: includes/Config.php:669
msgid "Availability check cycle"
msgstr ""

#: includes/Config.php:670
msgid "How often the centrally scheduled availability check starts. Internal batch continuations are not affected."
msgstr ""

#: includes/Config.php:677
msgid "Websites per availability-check batch"
msgstr ""

#: includes/Config.php:678
msgid "Number of websites checked in one availability-monitoring Cron request. The default of 10 keeps failed DNS or HTTP requests within the request budget; larger values can speed up healthy networks but may require more continuations when websites time out."
msgstr ""

