#: includes/Config.php:314
msgid "Media threshold for small storage-analysis batches"
msgstr ""

#: includes/Config.php:315
msgid "Websites at or below this number of media attachments are assigned to the small shared batch, unless their last successful active runtime exceeds its threshold."
msgstr ""

#: includes/Config.php:323
msgid "Media threshold for medium storage-analysis batches"
msgstr ""

#: includes/Config.php:324
msgid "Websites above the small-batch threshold and at or below this value are assigned to the medium shared batch, unless their last successful active runtime exceeds its threshold."
msgstr ""

#: includes/Config.php:332
msgid "Media threshold for large storage-analysis batches"
msgstr ""

#: includes/Config.php:333
msgid "Websites above the medium-batch threshold and at or below this value are assigned to the large shared batch, unless their last successful active runtime exceeds its threshold."
msgstr ""

#: includes/Config.php:341
msgid "Active runtime threshold for small storage-analysis batches in seconds"
msgstr ""

#: includes/Config.php:342
msgid "A website above this active runtime is moved from the small to the medium shared batch after a successful complete run."
msgstr ""

#: includes/Config.php:350
msgid "Active runtime threshold for medium storage-analysis batches in seconds"
msgstr ""

#: includes/Config.php:351
msgid "A website above this active runtime is moved from the medium shared batch to an individual task after a successful complete run."
msgstr ""

#: includes/Config.php:359
msgid "Active runtime threshold for large storage-analysis batches in seconds"
msgstr ""

#: includes/Config.php:360
msgid "A website above this active runtime is moved from the large shared batch to an individual task after a successful complete run."
msgstr ""

#: includes/Config.php:368
msgid "Media attachments per index step in medium storage analyses"
msgstr ""

#: includes/Config.php:369
msgid "Allowed values: 10 to 300. The default of 150 reduces Cron continuations where processing remains fast."
msgstr ""

#: includes/Config.php:377
msgid "Index segments written per step in medium storage analyses"
msgstr ""

#: includes/Config.php:378
msgid "Allowed values: 8 to 192. The default of 96 reduces Cron continuations where database writes remain fast."
msgstr ""

#: includes/Config.php:386
msgid "Media attachments per index step in shared storage analyses"
msgstr ""

#: includes/Config.php:387
msgid "Allowed values: 5 to 150. The default of 75 reduces Cron continuations for small shared batches."
msgstr ""

#: includes/Config.php:395
msgid "Index segments written per step in shared storage analyses"
msgstr ""

#: includes/Config.php:396
msgid "Allowed values: 4 to 128. The default of 64 reduces Cron continuations for small shared batches."
msgstr ""

#: includes/Config.php:404
msgid "Media attachments per index step in individual storage analyses"
msgstr ""

#: includes/Config.php:405
msgid "Allowed values: 25 to 1000. The default of 500 reduces Cron continuations for individual tasks."
msgstr ""

#: includes/Config.php:413
msgid "Media attachments per index step in large storage analyses"
msgstr ""

#: includes/Config.php:414
msgid "Allowed values: 25 to 600. The default of 300 reduces Cron continuations for large shared batches."
msgstr ""

#: includes/Config.php:422
msgid "Index segments written per step in large storage analyses"
msgstr ""

#: includes/Config.php:423
msgid "Allowed values: 8 to 256. The default of 128 reduces continuation requests for large shared batches."
msgstr ""

#: includes/Config.php:431
msgid "Index segments written per step in individual storage analyses"
msgstr ""

#: includes/Config.php:432
msgid "Allowed values: 8 to 256. The default of 128 reduces Cron continuations for individual tasks."
msgstr ""

#: includes/Config.php:440
msgid "Maximum concurrent background processes"
msgstr ""

#: includes/Config.php:441
msgid "Shared network-wide limit for storage analyses, shortcode and block analyses, dashboard metrics and availability checks. Default: 2. Allowed values: 1 to 8. Waiting tasks resume automatically."
msgstr ""

#: includes/Config.php:449
msgid "Maximum concurrent storage analyses per task type"
msgstr ""

#: includes/Config.php:450
msgid "Per-type limit for individual storage analyses and temporary indexes. The shared background process limit also applies. Small, medium and large shared batches each process one website at a time."
msgstr ""

