msgstr ""

#: includes/Config.php:145
msgid "Months until inactivity highlight"
msgstr ""

#: includes/Config.php:146
msgid "After how many months without new posts, pages, or media a site is highlighted in the long inactivity widget."
msgstr ""

#: includes/Config.php:155
msgid "Metrics cycle"
msgstr ""

#: includes/Config.php:156
msgid "How often the centrally scheduled metrics collection starts. Internal batch continuations are not affected."
msgstr ""

#: includes/Config.php:163
msgid "Batch size for network processes"
msgstr ""

#: includes/Config.php:164
msgid "Number of websites processed in each batch for dashboard metrics and website availability checks. Larger values complete a network pass faster but increase load per Cron request."
msgstr ""

#: includes/Config.php:172
msgid "Maximum storage size for browser analysis in MB"
msgstr ""

#: includes/Config.php:173
msgid "Up to this WordPress-reported storage usage, the storage analysis can run in browser batches. Larger websites are processed exclusively by scheduled background tasks."
msgstr ""

#: includes/Config.php:181
msgid "Small storage-analysis batch cycle"
msgstr ""

#: includes/Config.php:182
msgid "How often the central small storage-analysis batch is run."
msgstr ""

#: includes/Config.php:189
msgid "Medium storage-analysis batch cycle"
msgstr ""

#: includes/Config.php:190
msgid "How often the central medium storage-analysis batch is run."
msgstr ""

#: includes/Config.php:197
msgid "Individual storage-analysis cycle"
msgstr ""

#: includes/Config.php:198
msgid "How often individually scheduled storage analyses are run."
msgstr ""

#: includes/Config.php:205
msgid "Media threshold for small storage-analysis batches"
msgstr ""

#: includes/Config.php:206
msgid "Websites at or below this number of media attachments are assigned to the small shared batch, unless their last successful active runtime exceeds its threshold."
msgstr ""

#: includes/Config.php:214
msgid "Media threshold for medium storage-analysis batches"
msgstr ""

#: includes/Config.php:215
msgid "Websites above the small-batch threshold and at or below this value are assigned to the medium shared batch, unless their last successful active runtime exceeds its threshold."
msgstr ""

#: includes/Config.php:223
msgid "Active runtime threshold for small storage-analysis batches in seconds"
msgstr ""

#: includes/Config.php:224
msgid "A website above this active runtime is moved from the small to the medium shared batch after a successful complete run."
msgstr ""

#: includes/Config.php:232
msgid "Active runtime threshold for medium storage-analysis batches in seconds"
msgstr ""

#: includes/Config.php:233
msgid "A website above this active runtime is moved from the medium shared batch to an individual task after a successful complete run."
msgstr ""

#: includes/Config.php:241
msgid "Media attachments per index step in medium storage analyses"
msgstr ""

#: includes/Config.php:242
msgid "Allowed values: 10 to 50. Use the default of 35 for medium shared batches; larger values increase memory and database work per step."
msgstr ""

#: includes/Config.php:250
msgid "Index segments written per step in medium storage analyses"
msgstr ""

#: includes/Config.php:251
msgid "Allowed values: 8 to 24. Use the default of 20 for medium shared batches; larger values increase database work per step."
msgstr ""

#: includes/Config.php:259
msgid "Media attachments per index step in shared storage analyses"
msgstr ""

#: includes/Config.php:260
msgid "Allowed values: 5 to 25. Use 25 unless a shared batch causes noticeable load; 25 is the safe upper limit so one website cannot delay the remaining batch."
msgstr ""

#: includes/Config.php:268
msgid "Index segments written per step in shared storage analyses"
msgstr ""

#: includes/Config.php:269
msgid "Allowed values: 4 to 16. Use 16 unless database writes from shared batches cause noticeable load; 16 is the safe upper limit."
msgstr ""

#: includes/Config.php:277
msgid "Media attachments per index step in individual storage analyses"
msgstr ""

#: includes/Config.php:278
msgid "Allowed values: 25 to 100. The default of 50 is intended for websites with more than 1,000 media items. Only use 100 if the server has sufficient database and PHP capacity."
msgstr ""

#: includes/Config.php:286
msgid "Index segments written per step in individual storage analyses"
msgstr ""

#: includes/Config.php:287
msgid "Allowed values: 8 to 32. Use the default of 24; use 32 only if database writes remain fast. Larger values reduce continuation requests but increase database work per step."
msgstr ""

#: includes/Config.php:295
msgid "Maximum concurrent storage analyses"
msgstr ""

#: includes/Config.php:296
msgid "Allows four storage analyses and temporary indexes across the network by default, with up to eight. Additional analyses wait for capacity."
msgstr ""

#: includes/Config.php:304
msgid "Shortcode and block analysis cycle per website"
msgstr ""

#: includes/Config.php:305
msgid "How often the scheduled shortcode and block analysis is run for each website."
msgstr ""

#: includes/Config.php:312
msgid "Show analysis request notice to local administrators"
msgstr ""

#: includes/Config.php:313
msgid "When a website has neither a saved result nor a planned storage or shortcode-and-block analysis, show local administrators a request notice under Tools. When disabled, the relevant Tools page is hidden instead."
msgstr ""

#: includes/Config.php:319
msgid "Maximum active runtime for small storage-analysis batches in minutes"
msgstr ""

#: includes/Config.php:320
msgid "Limits active processing time across short scheduled steps for each individual website in the small batch, not for the entire batch. Waiting for Cron or analysis capacity does not count."
msgstr ""

#: includes/Config.php:328
msgid "Maximum active runtime for medium storage-analysis batches in minutes"
msgstr ""

#: includes/Config.php:329
msgid "Limits active processing time across short scheduled steps for each individual website in the medium batch, not for the entire batch. Waiting for Cron or analysis capacity does not count."
msgstr ""

#: includes/Config.php:337
msgid "Maximum active runtime for individual storage analyses in minutes"
msgstr ""

#: includes/Config.php:338
msgid "Limits active processing time across short scheduled steps for individual websites. Waiting for Cron or analysis capacity does not count. Values up to twelve hours are allowed."
msgstr ""

#: includes/Config.php:346
msgid "Maximum number of files for the orphan check"
msgstr ""

#: includes/Config.php:347
msgid "Only the largest potentially orphaned files up to this limit are checked for references in post and page content. The total number of detected files remains visible."
msgstr ""

#: includes/Config.php:355
msgid "Maximum shortcode and block analysis runtime in minutes"
msgstr ""

#: includes/Config.php:356
msgid "This limit applies to active PHP processing across resumable shortcode and block analysis steps. Waiting for the next Cron request does not count."
msgstr ""

#: includes/Config.php:364
msgid "Availability check cycle"
msgstr ""

#: includes/Config.php:365
msgid "How often the centrally scheduled availability check starts. Internal batch continuations are not affected."
msgstr ""

#: includes/Config.php:372
msgid "Provisioning grace period in hours"
msgstr ""

#: includes/Config.php:373
msgid "As long as a new site is younger than this grace period, it remains in status \"Provisioning in progress\" during technical problems instead of immediately counting as an issue."
msgstr ""

#: includes/Config.php:381
msgid "Threshold for DNS failure runs"
msgstr ""

#: includes/Config.php:382
msgid "Only after this number of consecutive DNS failures is the operational status set to \"DNS missing\"."
msgstr ""

#: includes/Config.php:390
msgid "Threshold for HTTP failure runs"
msgstr ""

#: includes/Config.php:391
msgid "Only after this number of consecutive HTTP failures is the operational status set to \"Technically unreachable\"."
msgstr ""

#: includes/Config.php:399
msgid "Retained monitoring runs"
msgstr ""

#: includes/Config.php:400
msgid "How many completed monitoring runs remain stored in the log."
msgstr ""

#: includes/Config.php:408
msgid "Visible issues"
msgstr ""

#: includes/Config.php:409
msgid "How many entries are shown at most in the \"Recently detected anomalies\" table."
msgstr ""

#: includes/Config.php:419
msgid "Logging"
msgstr ""

#: includes/Config.php:420
msgid "Send informational messages to the info channel."
msgstr ""

