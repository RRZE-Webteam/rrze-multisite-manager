msgstr ""
"Analysedaten konnten nicht gelesen oder gespeichert werden. Bitte die "
"Analyse erneut versuchen."

#. translators: 1: internal operation identifier, 2: database error category.
#: includes/Analysis/AnalysisStorageException.php:23
msgid ""
"Analysis data could not be read or saved (operation: %1$s; reason: %2$s). "
"See the error log."
msgstr ""
"Analysedaten konnten nicht gelesen oder gespeichert werden (Vorgang: %1$s; "
"Ursache: %2$s). Siehe Fehlerprotokoll."

#: includes/Analysis/AnalysisStore.php:450
msgid "The analysis data exceeded its storage budget."
msgstr "Die Analysedaten haben ihr Speicherbudget überschritten."

#: includes/Analysis/ContentAnalysisStore.php:24
